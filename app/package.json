{
  "name": "talon_kombainera",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android",
    "start:dev:nout": "npx env-cmd -f .env.dev.nout react-native start --reset-cache",
    "start:dev": "npx env-cmd -f .env.dev react-native start --reset-cache",
    "npx-react-native-start": "npx react-native start",
    "npx-react-native-start-with-typecheck": "npm run typecheck",
