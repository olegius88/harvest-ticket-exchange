    "npm-typecheck": "npm run typecheck",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "typecheck-strict": "tsc --noEmit --strict",
    "build:android:gradle-init": "cd android && fixGradlePermissionsAndBuild.bat",
    "build:android:win": "cd android && gradlew.bat assembleRelease && explorer \"app\\build\\outputs\\apk\\release\"",
    "build:android:inc-ver:win": "node ./android/app/incrementVersion.js && cd android && gradlew.bat assembleRelease && explorer \"app\\build\\outputs\\apk\\release\"",
    "build:android": "cd android && ./gradlew assembleRelease"
  },
