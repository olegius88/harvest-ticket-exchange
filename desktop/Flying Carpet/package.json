{
  "name": "vesovschik-tauri-svelte",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "version:bump": "node scripts/increment-version.cjs",
    "version:show": "node scripts/build-info.cjs",
    "open:bundle": "node scripts/open-bundle-dir.cjs",
    "build:info": "node scripts/build-info.cjs",
    "build:desktop": "npm run version:bump && npm run build && npm run tauri:build && npm run build:info && npm run open:bundle",
    "build:desktop:quick": "npm run build && npm run tauri:build && npm run build:info && npm run open:bundle"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/typography": "^0.5.10",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/plugin-store": "^2.3.0",
    "qrcode": "^1.5.4"
  }
}
